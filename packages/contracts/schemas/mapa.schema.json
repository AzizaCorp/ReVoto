{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mapa.schema.json",
  "title": "W-03: participación de cada municipio del país (mapa/participacion.json)",
  "type": "object",
  "required": [
    "fuente",
    "anios",
    "municipios"
  ],
  "properties": {
    "fuente": {
      "type": "string",
      "minLength": 1
    },
    "anios": {
      "type": "array",
      "items": {
        "$ref": "comun.schema.json#/$defs/anio"
      },
      "minItems": 1
    },
    "municipios": {
      "type": "object",
      "description": "cvegeo → [nombre, entidad, participación por año en el orden de «anios»; null = sin dato o RN-05].",
      "propertyNames": {
        "pattern": "^[0-9]{5}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "comun.schema.json#/$defs/proporcion"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
