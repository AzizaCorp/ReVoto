{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "calidad.schema.json",
  "description": "Reporte de calidad de una versión L4 (RF-24, W-20). Lo escribe export/exportar_ine_exploratorio.py.",
  "type": "object",
  "required": ["modalidad", "cobertura", "oficial", "geometria", "integridad"],
  "properties": {
    "modalidad": {
      "type": "string",
      "minLength": 1
    },
    "particiones_faltantes": {
      "type": "array"
    },
    "recursos_municipales": {
      "type": "integer",
      "minimum": 0
    },
    "colisiones_nombres_archivo_resueltas": {
      "type": "integer",
      "minimum": 0
    },
    "cobertura_nacional_anual": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32
      }
    },
    "cobertura": {
      "type": "object"
    },
    "electoral": {
      "type": "object"
    },
    "oficial": {
      "type": "object",
      "properties": {
        "estado": {
          "type": "string"
        },
        "max_diferencia_pp": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "topologia": {
      "type": "object"
    },
    "arquetipos": {
      "type": "object"
    },
    "geometria": {
      "type": "object"
    },
    "integridad": {
      "type": "object"
    },
    "equivalencias": {
      "type": "object"
    },
    "advertencias": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
