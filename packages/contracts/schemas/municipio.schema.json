{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "municipio.schema.json",
  "type": "object",
  "required": ["territorio", "fuente", "suprimido", "elecciones"],
  "properties": {
    "territorio": { "$ref": "comun.schema.json#/$defs/territorio" },
    "fuente": { "type": "string", "minLength": 1 },
    "suprimido": { "type": "boolean" },
    "elecciones": {
      "type": "array",
      "items": { "$ref": "comun.schema.json#/$defs/cifrasEleccion" }
    }
  },
  "if": { "properties": { "suprimido": { "const": true } } },
  "then": { "properties": { "elecciones": { "maxItems": 0 } } },
  "additionalProperties": false
}
