{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "type": "object",
  "required": ["version_datos", "generado", "fuente", "validacion"],
  "properties": {
    "version_datos": { "type": "string", "pattern": "^[0-9]{8}-[0-9a-f]{7}$" },
    "generado": { "type": "string" },
    "fuente": { "type": "string", "minLength": 1 },
    "validacion": {
      "type": "object",
      "required": ["max_diferencia_pp", "reporte"],
      "properties": {
        "max_diferencia_pp": { "type": "number", "minimum": 0, "maximum": 1 },
        "reporte": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
