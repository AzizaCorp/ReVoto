{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nacional.schema.json",
  "type": "object",
  "required": ["territorio", "fuente", "elecciones"],
  "properties": {
    "territorio": { "$ref": "comun.schema.json#/$defs/territorio" },
    "fuente": { "type": "string", "minLength": 1 },
    "elecciones": {
      "type": "array",
      "items": { "$ref": "comun.schema.json#/$defs/cifrasEleccion" }
    }
  },
  "additionalProperties": false
}
