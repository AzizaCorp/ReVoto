{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entidades.schema.json",
  "type": "array", "minItems": 32, "maxItems": 32,
  "items": {
    "type": "object", "required": ["cve", "nombre"],
    "properties": {
      "cve": { "type": "integer", "minimum": 1, "maximum": 32 },
      "nombre": { "type": "string", "minLength": 1 },
      "archivo": { "type": "string", "pattern": "^entidad/[a-z0-9_/-]+\\.json$" }
    }, "additionalProperties": false
  }
}
