{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revoto.local/schemas/frontend_v2.schema.json",
  "title": "REVOTO Read Model JSON v2 (new, not legacy L4)",
  "type": "object",
  "required": ["schema_version", "estado", "anio_eleccion", "grano", "fuentes"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "estado": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "anio_eleccion": {
      "type": "integer",
      "enum": [2009, 2012, 2015, 2018, 2021, 2024]
    },
    "grano": {
      "type": "string",
      "minLength": 1
    },
    "fuentes": {
      "type": "array",
      "items": {
        "enum": ["INE", "INEGI", "CONAPO"]
      },
      "minItems": 1
    },
    "referencias": {
      "type": "object"
    },
    "medidas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/medida"
      }
    },
    "contexto_municipal": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contexto_territorial": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "no_reasignar_votos": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "required": ["medidas"]
    },
    {
      "required": ["contexto_municipal"]
    },
    {
      "required": ["contexto_territorial"]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "medida": {
      "type": "object",
      "required": ["publicacion", "ln", "sv", "nv", "ns", "participacion_pct"],
      "properties": {
        "publicacion": {
          "enum": ["available", "unavailable", "suppressed"]
        },
        "ln": {
          "type": ["integer", "null"]
        },
        "sv": {
          "type": ["integer", "null"]
        },
        "nv": {
          "type": ["integer", "null"]
        },
        "ns": {
          "type": ["integer", "null"]
        },
        "participacion_pct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": true
    }
  }
}
